{
  "name": "rezahh107/persian-gravity",
  "description": "Generic Persian and Iranian enhancements for Gravity Forms.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1.2",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "scripts": {
    "test": "phpunit",
    "cs": "phpcs",
    "compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.2- persian-gravityforms.php includes admin uninstall.php",
    "i18n:pot": "wp i18n make-pot . languages/persian-gravityforms.pot --exclude=vendor,tests"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
