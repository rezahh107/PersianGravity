<?xml version="1.0"?>
<ruleset name="PersianGravity">
	<description>WordPress coding standards for the shipped PersianGravity runtime.</description>
	<file>persian-gravityforms.php</file>
	<file>includes</file>
	<file>admin</file>
	<file>uninstall.php</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Extra" />
	<arg name="extensions" value="php" />
	<arg value="ps" />
</ruleset>
